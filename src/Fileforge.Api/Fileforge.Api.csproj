      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fileforge.Application\Fileforge.Application.csproj" />
    <ProjectReference Include="..\Fileforge.Infrastructure\Fileforge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
